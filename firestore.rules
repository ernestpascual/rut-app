rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Allows authenticated owner OR temporary test account 'test' for development/preview testing
    function isOwner(uid) {
      return (isAuthenticated() && request.auth.uid == uid) || uid == 'test';
    }

    function isValidString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    function isValidOptString(val, maxLen) {
      return val == null || (val is string && val.size() <= maxLen);
    }

    function isValidOptList(val, maxSize) {
      return val == null || (val is list && val.size() <= maxSize);
    }

    // User document
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // Inspiration bank
      match /inspirations/{inspirationId} {
        allow read: if isOwner(uid);
        
        // Client can create if ownerUid matches and fields are within limits
        allow create: if isOwner(uid)
          && request.resource.data.ownerUid == uid
          && isValidString(request.resource.data.title, 300)
          && isValidOptString(request.resource.data.userNote, 5000)
          && isValidOptString(request.resource.data.sharedText, 10000)
          && isValidOptString(request.resource.data.url, 2048)
          && isValidOptList(request.resource.data.tags, 30);

        // Client can update user-editable fields (title, userNote, tags, archived)
        // Client CANNOT forge server-only AI fields or change ownerUid
        allow update: if isOwner(uid)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && isValidString(request.resource.data.title, 300)
          && isValidOptString(request.resource.data.userNote, 5000)
          && isValidOptList(request.resource.data.tags, 30);

        allow delete: if isOwner(uid);
      }

      // Chats (trains of thought)
      match /chats/{chatId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.ownerUid == uid
          && isValidString(request.resource.data.title, 200);
        allow update: if isOwner(uid)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && isValidString(request.resource.data.title, 200);
        allow delete: if isOwner(uid);

        // Chat messages
        match /messages/{messageId} {
          allow read: if isOwner(uid);
          // User messages can be created by client; assistant messages created by functions
          allow create: if isOwner(uid)
            && isValidString(request.resource.data.content, 10000)
            && (request.resource.data.role == "user" || request.resource.data.role == "assistant");
          allow update, delete: if isOwner(uid);
        }
      }

      // Projects
      match /projects/{projectId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.ownerUid == uid
          && isValidString(request.resource.data.title, 200)
          && isValidOptString(request.resource.data.brief, 5000);
        allow update: if isOwner(uid)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && isValidString(request.resource.data.title, 200)
          && isValidOptString(request.resource.data.brief, 5000);
        allow delete: if isOwner(uid);

        // Project inspiration links
        match /inspirationLinks/{linkId} {
          allow read: if isOwner(uid);
          allow create, update, delete: if isOwner(uid);
        }
      }

      // Usage events and summaries (Client READ-ONLY, written strictly by backend Functions)
      match /usageEvents/{eventId} {
        allow read: if isOwner(uid);
        allow write: if false; // Only Admin SDK can write
      }

      match /usageSummaries/{period} {
        allow read: if isOwner(uid);
        allow write: if false; // Only Admin SDK can write
      }
    }

    // Server-only collections: Clients have ZERO direct access
    match /_aiInspirationIndex/{indexId} {
      allow read, write: if false;
    }

    match /_systemConfig/{documentId} {
      allow read, write: if false;
    }
  }
}
