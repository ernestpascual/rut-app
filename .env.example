# ==============================================================================
# Client-side Firebase Configuration (Configured for izepak)
# ==============================================================================
EXPO_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN="izepak.firebaseapp.com"
EXPO_PUBLIC_FIREBASE_PROJECT_ID="izepak"
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET="izepak.firebasestorage.app"
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="53941543805"
EXPO_PUBLIC_FIREBASE_APP_ID="1:53941543805:web:c796434bf9da4d3bb52214"

# Optional: Firebase Emulators (1 = enable local emulators, 0 = live Firebase)
EXPO_PUBLIC_USE_FIREBASE_EMULATOR="0"
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST="127.0.0.1"

# ==============================================================================
# Google Gemini AI Configuration (Used by Firebase Cloud Functions backend)
# ==============================================================================
# Paste your Google Gemini API key below:
# (Obtain key from Google AI Studio: https://aistudio.google.com/)
#
# In local development:
#   Place GEMINI_API_KEY in your local backend environment or functions/.env
# In production Firebase deployment:
#   Configure securely via Firebase Secret Manager:
#   npx firebase-tools functions:secrets:set GEMINI_API_KEY --project izepak
GEMINI_API_KEY="your-gemini-api-key"

# Flash model selection (STRICTLY 3.5 AND ABOVE, FLASH ONLY)
# Allowed options (must include 'flash' and version >= 3.5):
#   - gemini-3.5-flash (Default recommended Flash model)
#   - gemini-3.5-flash-preview
#   - gemini-4.0-flash
#   - gemini-4.5-flash
# NOTE: Non-flash models (e.g. Pro, Ultra) and models below 3.5 (e.g. 1.5, 2.0, 2.5, 3.0) are strictly rejected.
GEMINI_MODEL="gemini-3.5-flash"
